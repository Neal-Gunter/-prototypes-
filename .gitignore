# ============================================================
# 玄界 XUANJIE · .gitignore
# 原则：源码 / 文档 / 美术资源入库；构建产物与密钥不入库。
# ============================================================

# ---------- 构建产物（每个 40~120MB，绝不入库）----------
*.exe
*.apk
*.aab
*.idsig
*.pck
XUANJIE_R*.exe
XUANJIE_R*.apk

# ---------- Godot 缓存与中间文件 ----------
.godot/
*.tmp
*.translation
/android/

# ---------- 签名与导出配置（含明文口令，绝不入库）----------
keystore/
*.keystore
*.jks
export_presets.cfg

# ---------- 临时截图工具（每轮用完即弃，不进版本）----------
tools/_r*_shot.gd

# ---------- 系统 / 编辑器杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
!docs/自测记录_*.log
